{
  "name": "tannhauser-digital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/client",
    "build": "npm run build -w apps/client",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:quick": "vitest run --exclude **/ai-game.spec.ts",
    "test:core": "vitest run packages/core",
    "test:content": "vitest run packages/content",
    "test:renderer": "vitest run packages/renderer",
    "test:client": "vitest run apps/client --exclude **/ai-game.spec.ts",
    "test:ai": "vitest run apps/client/src/ai-game.spec.ts apps/client/src/ai-driver.spec.ts",
    "generate:boards": "vite-node tools/board-generator/generate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
